{
  "expo": {
    "name": "embarcados-mobile",
    "slug": "embarcados-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "embarcadosmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/santa-catarina-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/santa-catarina-logo.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65a336e7-ef11-44bb-b17f-c946cef04970"
      }
    },
    "owner": "gustavodorows-team"
  }
}
